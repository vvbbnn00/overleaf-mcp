{
  "name": "overleaf-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local MCP server for Overleaf projects, live editing, file transfer and compilation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "login": "npm run build --silent && node dist/cli.js login",
    "start": "node dist/cli.js serve",
    "dev": "npm run build --silent && node dist/cli.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "playwright": "^1.64.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
