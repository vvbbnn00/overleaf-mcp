{
  "name": "overleaf-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "vvbbnn00",
  "type": "module",
  "description": "Unofficial MCP server for Overleaf: live LaTeX editing, file uploads and downloads, project history, review comments, and PDF compilation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvbbnn00/overleaf-mcp.git"
  },
  "keywords": [
    "overleaf",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "latex",
    "tex",
    "typescript",
    "pdf",
    "collaboration"
  ],
  "bin": {
    "overleaf-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build",
    "login": "npm run build --silent && node dist/cli.js login",
    "start": "node dist/cli.js serve",
    "dev": "npm run build --silent && node dist/cli.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "playwright": "^1.64.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
